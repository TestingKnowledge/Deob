-- ===== MOTION HELPERS =====
local function createLinearMover(root)
    if not root or not root.Parent then
        return nil, nil
    end

    local attachment = Instance.new("Attachment")
    attachment.Name = "AutoFlightAttachment"
    attachment.Parent = root

    local lv = Instance.new("LinearVelocity")
    lv.Name = "AutoFlightLinearVelocity"
    lv.Attachment0 = attachment
    lv.RelativeTo = Enum.ActuatorRelativeTo.World
    lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    lv.VectorVelocity = Vector3.zero

    pcall(function()
        lv.ForceLimitsEnabled = false
    end)

    pcall(function()
        lv.MaxForce = math.huge
    end)

    lv.Parent = root

    return lv, attachment
end

local function createFlightGyro(root)
    if not root or not root.Parent then
        return nil
    end

    local bg = Instance.new("BodyGyro")
    bg.Name = "AutoFlightBodyGyro"
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.D = 50000
    bg.P = 1500000000
    bg.CFrame = root.CFrame
    bg.Parent = root

    return bg
end

local function destroyMover(lv, attachment, bg)
    if bg then
        pcall(function() bg:Destroy() end)
    end
    if lv then
        pcall(function() lv:Destroy() end)
    end
    if attachment then
        pcall(function() attachment:Destroy() end)
    end
end

local function cleanupOldMotion(root)
    if not root then return end

    for _, obj in ipairs(root:GetChildren()) do
        if obj.Name == "AutoFlightLinearVelocity"
        or obj.Name == "AutoFlightAttachment"
        or obj.Name == "AutoFlightBodyGyro"
        or obj.Name == "AutoFlightAlignOrientation" then
            pcall(function() obj:Destroy() end)    
        end
    end
end

local function moveToFlightAltitude(root, targetAltitude, maxSpeed)
    if not root or not root.Parent then
        return nil
    end

    cleanupOldMotion(root)

    local lv, attachment = createLinearMover(root)
    local bg = createFlightGyro(root)

    if not lv then return nil end

    local speed = maxSpeed or 300
    local startTime = tick()
    local timeout = 12

    while root and root.Parent and IsInVehicle() do
        local diffY = targetAltitude - root.Position.Y

        if math.abs(diffY) <= 1.0 then    
            lv.VectorVelocity = Vector3.zero    
            break    
        end    

        local verticalSpeed = math.clamp(diffY * 5, -speed, speed)    

        lv.VectorVelocity = Vector3.new(0, verticalSpeed, 0)    

        if bg then    
            bg.CFrame = CFrame.new(root.Position)    
        end    

        if tick() - startTime >= timeout then    
            lv.VectorVelocity = Vector3.zero    
            break    
        end    

        task.wait()
    end

    if root and root.Parent and IsInVehicle() then
        lv.VectorVelocity = Vector3.zero
        if bg then bg.CFrame = CFrame.new(root.Position) end    
        return {    
            lv = lv,    
            attachment = attachment,    
            bg = bg,    
            altitude = targetAltitude    
        }
    end

    destroyMover(lv, attachment, bg)
    return nil
end

local function maintainFlightHover(root, hover, targetAltitude)
    if not root or not root.Parent or not hover or not hover.lv then
        return
    end

    local diffY = targetAltitude - root.Position.Y
    local verticalSpeed = math.clamp(diffY * 5, -300, 300)

    if math.abs(diffY) <= 1.0 then
        verticalSpeed = 0
    end

    hover.lv.VectorVelocity = Vector3.new(0, verticalSpeed, 0)

    if hover.bg then
        hover.bg.CFrame = CFrame.new(root.Position)
    end
end
