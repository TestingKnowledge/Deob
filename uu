    print("[SERVER CHECK] Players:",playerCount,"Criminals:",criminalCount)
    if playerCount>=Config.AntiFullServerPlayers then
        ServerHop("ANTI-FULL SERVER")
        return true
    end
    if playerCount>=Config.ServerHopMinPlayers and playerCount<=Config.ServerHopMaxPlayers and criminalCount<Config.ServerHopCriminalLimit then
        ServerHop("TOO FEW CRIMINALS")
        return true
    end
    return false
end
