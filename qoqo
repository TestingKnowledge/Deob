local function launchUpToSafety(root, launchAmount)
    print("[SAFETY TRIGGERED] Target went underground/indoors! Ascending back up...")
    local targetY = root.Position.Y + (launchAmount or Config.AbortLaunchHeight)
    while root.Parent and root.Position.Y < targetY and IsInVehicle() do
        local dt = task.wait()
        root.CFrame = CFrame.new(root.Position + Vector3.new(0, 200 * dt, 0))
    end
end

local function flyToPos(char, root, targetPos)
    if IsInVehicle() then return end
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.Velocity = Vector3.zero
    bv.Parent = root
    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bg.CFrame = root.CFrame
    bg.Parent = root

    local function moveTo(dest, speed)
        while char.Parent and root.Parent and not IsInVehicle() do
            local diff = dest - root.Position
            local dist = diff.Magnitude
            local dt = task.wait()
            if dist <= speed * dt then
                root.CFrame = CFrame.new(dest)
                break
            end
            root.CFrame = CFrame.new(root.Position + diff.Unit * (speed * dt))
        end
    end

    local upPos = root.Position + Vector3.new(0, Config.UpHeight, 0)
    local cruisePos = Vector3.new(targetPos.X, upPos.Y, targetPos.Z)
    local downPos = targetPos + Vector3.new(0, Config.DownOffset, 0)
    moveTo(upPos, Config.UpSpeed)
    moveTo(cruisePos, Config.CruiseSpeed)
    moveTo(downPos, Config.DownSpeed)
    bv:Destroy()
    bg:Destroy()
end

-- Function to compute predicted future position based on target velocity
local function GetPredictedPosition(targetRoot)
    local velocity = targetRoot.AssemblyLinearVelocity or Vector3.zero
    -- Ignore vertical velocity to prevent ground clipping issues
    local flatVelocity = Vector3.new(velocity.X, 0, velocity.Z)
    local advanceOffset = flatVelocity * Config.PredictionTime
    
    if advanceOffset.Magnitude > Config.MaxPredictionStuds then
        advanceOffset = advanceOffset.Unit * Config.MaxPredictionStuds
    end
    
    return targetRoot.Position + advanceOffset
end

-- ENHANCED ON-FOOT PURSUIT WITH ADVANCE STUDS & PREDICTIVE TARGET LOCKING
local function flyOnFootToTargetAndBackTeleport(char, root, crimPlayer, speed)
    local crimChar = crimPlayer.Character
    local targetRoot = crimChar and crimChar:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.Velocity = Vector3.zero
    bv.Parent = root

    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bg.CFrame = root.CFrame
    bg.Parent = root

    -- Phase 1: Predictive Flight towards target's future path
    while char.Parent and root.Parent and targetRoot and targetRoot.Parent and not IsInVehicle() do
        if IsUndergroundOrIndoor(crimChar) then
            print("[ON FOOT ABORT] Target entered building/cave during foot chase!")
            bv:Destroy()
            bg:Destroy()
            return
        end

        EquipHandcuffs()

        -- Calculate predicted position ahead of the criminal
        local predictedPos = GetPredictedPosition(targetRoot)
        local diff = predictedPos - root.Position
        local dist = (targetRoot.Position - root.Position).Magnitude
        local dt = task.wait()

        -- Always lock camera/orientation directly to the actual target
        bg.CFrame = CFrame.lookAt(root.Position, Vector3.new(targetRoot.Position.X, root.Position.Y, targetRoot.Position.Z))

        if dist <= Config.CloseBackDistance then
            print("[TARGET LOCKED] Reached contact zone! Switching to sticky back-teleport...")
            break
        end

        -- Move toward the predicted future position
        if diff.Magnitude > 0 then
            root.CFrame = CFrame.new(root.Position + diff.Unit * math.min(speed * dt, diff.Magnitude))
        end
    end

    bv:Destroy()
    bg:Destroy()

    -- Phase 2: Predictive Loop Teleport & Instant Lock
    while char.Parent and root.Parent and targetRoot and targetRoot.Parent and not IsInVehicle() do
        if IsUndergroundOrIndoor(crimChar) then
            print("[TELEPORT ABORT] Target ran inside building/cave!")
            break
        end

        EquipHandcuffs()

        if typeof(sethiddenproperty) == "function" then
            pcall(function()
                sethiddenproperty(root, "PhysicsRepRootPart", targetRoot)
            end)
        end

        -- Compute direct position relative to moving frame
        local velLead = (targetRoot.AssemblyLinearVelocity * 0.15)
        local leadPos = targetRoot.Position + velLead
        
        -- Place local player slightly ahead/behind relative to movement direction
        local backCFrame = CFrame.new(leadPos, leadPos + targetRoot.CFrame.LookVector) * CFrame.new(0, 0, Config.BackOffset)
        root.CFrame = backCFrame

        ArrestTarget(crimPlayer)
        task.wait()
    end
end

local function flyVehicleToCriminal(root, crimPlayer, speed)
    local crimChar = crimPlayer.Character
    local crimRoot = crimChar and crimChar:FindFirstChild("HumanoidRootPart")
    if not crimRoot then return false end

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.Velocity = Vector3.zero
    bv.Parent = root

    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bg.CFrame = root.CFrame
    bg.Parent = root

    local targetInVeh = crimChar:GetAttribute("InVehicle")
    local stopDistance = targetInVeh and Config.TeleportDistance or Config.OnFootDescendDistance
    local aborted = false

    -- 1. Fly horizontally overhead with target velocity leading
    while root.Parent and IsInVehicle() and crimRoot and crimRoot.Parent do
        if IsUndergroundOrIndoor(crimChar) then
            aborted = true
            break
        end

        local targetPos = GetPredictedPosition(crimRoot)
        local overheadPos = Vector3.new(targetPos.X, root.Position.Y, targetPos.Z)
        local diff = overheadPos - root.Position
        local dist = diff.Magnitude
        local dt = task.wait()

        bg.CFrame = CFrame.lookAt(root.Position, Vector3.new(overheadPos.X, root.Position.Y, overheadPos.Z))
        if dist <= speed * dt then
            root.CFrame = CFrame.new(overheadPos)
            break
        end
        root.CFrame = CFrame.new(root.Position + diff.Unit * (speed * dt))
    end

    -- 2. Descend towards target
    while not aborted and root.Parent and IsInVehicle() and crimRoot and crimRoot.Parent do
        if IsUndergroundOrIndoor(crimChar) then
            aborted = true
            break
        end

        local currentTarget = crimRoot.Position
        local currentDist = (root.Position - currentTarget).Magnitude

        if currentDist <= stopDistance then
            break
        end

        local diff = currentTarget - root.Position
        local dt = task.wait()
        bg.CFrame = CFrame.lookAt(root.Position, currentTarget)

        if diff.Magnitude <= speed * dt then
            root.CFrame = CFrame.new(currentTarget)
            break
        end
        root.CFrame = CFrame.new(root.Position + diff.Unit * (speed * dt))
    end

    bv:Destroy()
    bg:Destroy()

    if aborted then
        launchUpToSafety(root, 300)
        return false
    end

    -- 3. Vehicle Action or On Foot Transition
    if crimRoot and crimRoot.Parent then
        if not targetInVeh then
            print("[TARGET ON FOOT] Transitioning to predicted foot pursuit...")
            pressSpaceKey()
            EquipHandcuffs()
            task.wait(0.2)

            local char = LocalPlayer.Character
            local myRoot = char and char:FindFirstChild("HumanoidRootPart")
            if myRoot and crimRoot and crimRoot.Parent then
                flyOnFootToTargetAndBackTeleport(char, myRoot, crimPlayer, Config.OnFootFlySpeed)
            end
        else
            print("[TARGET IN VEHICLE] Teleporting vehicle on target and ejecting...")
            local targetVehicle = GetTargetVehicle(crimChar)

            if targetVehicle then
                local initialPop = targetVehicle:GetAttribute("VehicleTiresLastPop")

                while root.Parent and IsInVehicle() and crimRoot and crimRoot.Parent do
                    if IsUndergroundOrIndoor(crimChar) then
                        print("[RAMMING ABORT] Target entered roof/cave while in vehicle!")
                        launchUpToSafety(root, 300)
                        return false
                    end

                    if typeof(sethiddenproperty) == "function" then
                        pcall(function()
                            sethiddenproperty(root, "PhysicsRepRootPart", crimRoot)
                        end)
                    end
                    root.CFrame = crimRoot.CFrame

                    EjectVehicleTarget(targetVehicle)

                    local currentPop = targetVehicle:GetAttribute("VehicleTiresLastPop")
                    local stillInVeh = crimChar:GetAttribute("InVehicle")

                    if currentPop ~= initialPop or not stillInVeh then
                        print("[TIRE POPPED / EXITED] Stopping vehicle teleport...")
                        break
                    end

                    task.wait()
                end
            end

            print("[AFTER RAMMING] Chasing target with predictive tracking...")
            pressSpaceKey()
            EquipHandcuffs()
            task.wait(0.2)

            local char = LocalPlayer.Character
            local myRoot = char and char:FindFirstChild("HumanoidRootPart")
            if myRoot and crimRoot and crimRoot.Parent then
                flyOnFootToTargetAndBackTeleport(char, myRoot, crimPlayer, Config.OnFootFlySpeed)
            end
        end
    end
    return true
end

local function handleVehicleFlight()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local targetY = root.Position.Y + 500
    local launchVelocity = Instance.new("BodyVelocity")
    launchVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    launchVelocity.Velocity = Vector3.new(0, 200, 0)
    launchVelocity.Parent = root

    while root.Parent and root.Position.Y < targetY and IsInVehicle() do
        task.wait()
    end
    launchVelocity:Destroy()

    while root.Parent and IsInVehicle() do
        local nearestCrim, _ = FindNearestCriminal(root)
        if nearestCrim then
            local success = flyVehicleToCriminal(root, nearestCrim, Config.CriminalCruiseSpeed)
            if not success then
                task.wait(0.5)
            else
                break
            end
        else
            break
        end
    end

    local cfg = rawget(getfenv(), "configs") or { vehicle = { fx = 0, fy = 0, fz = 0, fspeed = 100, ftog = true } }
    local cl = rawget(getfenv(), "client") or { vehicleEntered = true }

    local BodyGyro = Instance.new("BodyGyro", root)
    local BodyVelocity = Instance.new("BodyVelocity", root)
    local Camera = workspace.CurrentCamera

    BodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    BodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    BodyGyro.D = 50000
    BodyGyro.P = 1500000000

    repeat
        task.wait()
        if not root.Parent then break end
        BodyGyro.CFrame = Camera.CFrame * CFrame.Angles(
            math.rad(cfg.vehicle.fx or 0), 
            math.rad(cfg.vehicle.fy or 0), 
            math.rad(cfg.vehicle.fz or 0)
        )
        Camera.CameraType = Enum.CameraType.Track
        BodyVelocity.Velocity = Vector3.zero

        local playerModule = LocalPlayer.PlayerScripts:FindFirstChild("PlayerModule")
        local controlModule = playerModule and playerModule:FindFirstChild("ControlModule")
        if controlModule then
            local direction = require(controlModule):GetMoveVector()
            if direction.X > 0 then
                BodyVelocity.Velocity = BodyVelocity.Velocity + Camera.CFrame.RightVector * direction.X
            end
            if direction.X < 0 then
                BodyVelocity.Velocity = BodyVelocity.Velocity + Camera.CFrame.RightVector * direction.X
            end
            if direction.Z > 0 then
                BodyVelocity.Velocity = BodyVelocity.Velocity - Camera.CFrame.LookVector * direction.Z
            end
            if direction.Z < 0 then
                BodyVelocity.Velocity = BodyVelocity.Velocity - Camera.CFrame.LookVector * direction.Z
            end
            BodyVelocity.Velocity = BodyVelocity.Velocity * (cfg.vehicle.fspeed or 100)
        end
    until not IsInVehicle() or cl.vehicleEntered == false or cfg.vehicle.ftog == false

    Camera.CameraType = Enum.CameraType.Custom
    BodyGyro:Destroy()
    BodyVelocity:Destroy()
end

local function onSpawn(char)
    if isRunning then return end
    isRunning = true
    local root = char:WaitForChild("HumanoidRootPart", 10)
    if not root then isRunning = false return end
    task.wait(0.5)

    if IsInVehicle() then
        handleVehicleFlight()
        isRunning = false
        return
    end

    local closestData, minDist = nil, math.huge
    for _, data in pairs(Stations) do
        local dist = (root.Position - data.Base).Magnitude
        if dist < minDist then
            minDist = dist
            closestData = data
        end
    end

    if closestData then
        for _, wp in ipairs(closestData.Path) do
            if not char.Parent or not root.Parent or IsInVehicle() then break end
            char:PivotTo(CFrame.new(wp))
            task.wait(0.2)
        end
    end

    local blacklisted = {}
    while char.Parent and root.Parent and not IsInVehicle() do
        local nearestVeh = FindNearestCamaroOrJeep(root, blacklisted)
        if not nearestVeh then break end
        flyToPos(char, root, nearestVeh:GetPivot().Position)
        if IsInVehicle() then break end
        task.wait(0.1)
        for _ = 1, 5 do
            enterVehicle(root)
            task.wait(0.3)
            if IsInVehicle() then break end
        end

        if IsInVehicle() then
            handleVehicleFlight()
            break
        else
            blacklisted[nearestVeh] = true
        end
    end
    isRunning = false
end

LocalPlayer.CharacterAdded:Connect(onSpawn)
if LocalPlayer.Character then task.spawn(onSpawn, LocalPlayer.Character) end
