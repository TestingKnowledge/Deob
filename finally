    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
        task.wait(Config.SpacebarTapDuration)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
    end)
end

-- NEW FUNCTION: Yields until the player has successfully disconnected from the seat
local function ForceExitVehicle()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    -- Give it a maximum of 2 seconds so it never infinite yields if stuck
    local timeout = tick() + 2
    while IsInVehicle() and tick() < timeout do
        if hum then hum.Sit = false end
        pressSpaceKey()
        task.wait(0.1)
    end
end

local function EquipHandcuffs()
    if not invSys then return false end
    local success = false
    pcall(function()
        for _, item in pairs(invSys.getInventoryItemsFor(LocalPlayer)) do
            if item.obj and item.obj.Name == "Handcuffs" then
                item:AttemptSetEquipped(true)
                success = true
                break
            end
        end
    end)
    return success
end

local function EjectVehicleTarget(targetVeh)
    if not targetVeh then return end
    local uiModule = ReplicatedStorage:FindFirstChild("Module", true) and require(ReplicatedStorage.Module:FindFirstChild("UI", true) or ReplicatedStorage.Module)
    if uiModule and uiModule.CircleAction and uiModule.CircleAction.Specs then
        for _, spec in pairs(uiModule.CircleAction.Specs) do
            local isMatch = false
            if spec.Part and (targetVeh:IsAncestorOf(spec.Part) or spec.Part:IsDescendantOf(targetVeh)) then
                isMatch = true
            elseif spec.Text then
                local tLow = spec.Text:lower()
                for _, keyword in ipairs(Config.EjectKeywords) do
                    if tLow:find(keyword) then
                        isMatch = true
                        break
                    end
                end
            end

            if isMatch then
                pcall(function() spec:Callback(true) end)
                break
            end
        end
    end
end

local function ArrestTarget(targetPlayer)
    if attemptArrest and targetPlayer then
        pcall(function() attemptArrest(targetPlayer) end)
    end
end

local function launchUpToSafety(root, launchAmount)
    print("[SAFETY TRIGGERED] Target invalid or went indoors! Ascending back up...")
    local targetY = root.Position.Y + (launchAmount or Config.AbortLaunchHeight)
    
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(Config.PhysicsMaxForce, Config.PhysicsMaxForce, Config.PhysicsMaxForce)
    bv.Velocity = Vector3.new(0, Config.AscentSpeed, 0)
    bv.Parent = root
    
    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(Config.PhysicsMaxForce, Config.PhysicsMaxForce, Config.PhysicsMaxForce)
    local look = root.CFrame.LookVector
    -- Keeps the car leveled out when ascending
    bg.CFrame = CFrame.lookAt(root.Position, root.Position + Vector3.new(look.X, 0, look.Z))
    bg.Parent = root
    
    while root.Parent and root.Position.Y < targetY and IsInVehicle() do
        task.wait()
    end
    
    bv:Destroy()
    bg:Destroy()
end

local function flyToPos(char, root, targetPos)
    if IsInVehicle() then return end
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(Config.PhysicsMaxForce, Config.PhysicsMaxForce, Config.PhysicsMaxForce)
    bv.Velocity = Vector3.zero
    bv.Parent = root
    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(Config.PhysicsMaxForce, Config.PhysicsMaxForce, Config.PhysicsMaxForce)
    bg.CFrame = root.CFrame
    bg.Parent = root

    local function moveTo(dest, speed)
        while char.Parent and root.Parent and not IsInVehicle() do
            local diff = dest - root.Position
            local dist = diff.Magnitude
            local dt = task.wait()
            if dist <= speed * dt then
                root.CFrame = CFrame.new(dest)
                break
            end
            root.CFrame = CFrame.new(root.Position + diff.Unit * (speed * dt))
        end
    end

    local upPos = root.Position + Vector3.new(0, Config.AscentHeight, 0)
    local cruisePos = Vector3.new(targetPos.X, upPos.Y, targetPos.Z)
    local downPos = targetPos + Vector3.new(0, Config.DescentOffset, 0)
    moveTo(upPos, Config.AscentSpeed)
    moveTo(cruisePos, Config.CruiseSpeed)
    moveTo(downPos, Config.DescentSpeed)
    bv:Destroy()
    bg:Destroy()
end

local function flyOnFootToTargetAndBackTeleport(char, root, crimPlayer, speed)
    local crimChar = crimPlayer.Character
    local targetRoot = crimChar and crimChar:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(Config.PhysicsMaxForce, Config.PhysicsMaxForce, Config.PhysicsMaxForce)
    bv.Velocity = Vector3.zero
    bv.Parent = root

    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(Config.PhysicsMaxForce, Config.PhysicsMaxForce, Config.PhysicsMaxForce)
    bg.CFrame = root.CFrame
    bg.Parent = root

    while char.Parent and root.Parent and targetRoot and targetRoot.Parent and not IsInVehicle() do
        if IsUndergroundOrIndoor(crimChar) then
            print("[ON FOOT ABORT] Target entered building/cave during foot chase!")
            bv:Destroy()
            bg:Destroy()
            return
        end

        EquipHandcuffs()
        local diff = targetRoot.Position - root.Position
        local dist = diff.Magnitude
        local dt = task.wait()

        bg.CFrame = CFrame.lookAt(root.Position, targetRoot.Position)

        if dist <= Config.CloseBackDistance then
            print("[CLOSE ENOUGH] Reached close distance! Switching to loop teleport behind back & arresting...")
            break
        end

        root.CFrame = CFrame.new(root.Position + diff.Unit * (speed * dt))
    end

    bv:Destroy()
    bg:Destroy()

    -- =========================================================================
    -- THE TELEPORT LOOP
    -- =========================================================================
    while char.Parent and root.Parent and targetRoot and targetRoot.Parent and not IsInVehicle() do
        if IsUndergroundOrIndoor(crimChar) then
            print("[TELEPORT ABORT] Target ran inside building/cave!")
            break
        end

        EquipHandcuffs()
        if typeof(sethiddenproperty) == "function" then
            pcall(function()
                sethiddenproperty(root, "PhysicsRepRootPart", targetRoot)
            end)
        end
        local backCFrame = targetRoot.CFrame * CFrame.new(0, 0, Config.BackOffset)
        root.CFrame = backCFrame

        ArrestTarget(crimPlayer)

        task.wait(Config.OnFootTeleportDelay) -- <-- MODIFIED HERE
    end
end

local function flyVehicleToCriminal(root, crimPlayer, speed)
    local crimChar = crimPlayer.Character
    local crimRoot = crimChar and crimChar:FindFirstChild("HumanoidRootPart")
    if not crimRoot then return false end

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(Config.PhysicsMaxForce, Config.PhysicsMaxForce, Config.PhysicsMaxForce)
    bv.Velocity = Vector3.zero
    bv.Parent = root

    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(Config.PhysicsMaxForce, Config.PhysicsMaxForce, Config.PhysicsMaxForce)
    bg.CFrame = root.CFrame
    bg.Parent = root

    local targetInVeh = crimChar:GetAttribute("InVehicle")
    local stopDistance = targetInVeh and Config.VehicleTeleportDistance or Config.OnFootDescendDistance
    local aborted = false

    while root.Parent and IsInVehicle() do
        -- Check if target is valid inside the loop to guarantee the abort triggers
        if not (crimRoot and crimRoot.Parent) or IsUndergroundOrIndoor(crimChar) then
            aborted = true
            break
        end

        local targetPos = crimRoot.Position
        local overheadPos = Vector3.new(targetPos.X, root.Position.Y, targetPos.Z)
        local diff = overheadPos - root.Position
        local dist = diff.Magnitude
        local dt = task.wait()

        bg.CFrame = CFrame.lookAt(root.Position, Vector3.new(overheadPos.X, root.Position.Y, overheadPos.Z))
        if dist <= speed * dt then
            root.CFrame = CFrame.new(overheadPos)
            break
        end
        root.CFrame = CFrame.new(root.Position + diff.Unit * (speed * dt))
    end

    while not aborted and root.Parent and IsInVehicle() do
        if not (crimRoot and crimRoot.Parent) or IsUndergroundOrIndoor(crimChar) then
            aborted = true
            break
        end

        local currentTarget = crimRoot.Position
        local currentDist = (root.Position - currentTarget).Magnitude

        if currentDist <= stopDistance then
            break
        end

        local diff = currentTarget - root.Position
        local dt = task.wait()
        bg.CFrame = CFrame.lookAt(root.Position, currentTarget)

        if diff.Magnitude <= speed * dt then
            root.CFrame = CFrame.new(currentTarget)
            break
        end
        root.CFrame = CFrame.new(root.Position + diff.Unit * (speed * dt))
    end

    bv:Destroy()
    bg:Destroy()

    if aborted then
        launchUpToSafety(root, Config.AbortLaunchHeight)
        return false
    end

    if crimRoot and crimRoot.Parent then
        if not targetInVeh then
            print("[TARGET ON FOOT] Dropped down, jumping out, equipping handcuffs & chasing target...")
            ForceExitVehicle() -- Changed to yielding exit function
            EquipHandcuffs()
            task.wait(Config.EquipWait)

            local char = LocalPlayer.Character
            local myRoot = char and char:FindFirstChild("HumanoidRootPart")
            if myRoot and crimRoot and crimRoot.Parent then
                flyOnFootToTargetAndBackTeleport(char, myRoot, crimPlayer, Config.OnFootFlySpeed)
            end
        else
            print("[TARGET IN VEHICLE] Teleporting vehicle on target and ejecting until tire pop / health drop / exit...")
            local targetVehicle = GetTargetVehicle(crimChar)

            if targetVehicle then
                local initialPop = targetVehicle:GetAttribute("VehicleTiresLastPop") or 0
                local initialTireHealth = targetVehicle:GetAttribute("VehicleTireHealth") or 100

                while root.Parent and IsInVehicle() do
                    if not (crimRoot and crimRoot.Parent) or IsUndergroundOrIndoor(crimChar) then
                        print("[RAMMING ABORT] Target went invalid or entered roof/cave while in vehicle!")
                        launchUpToSafety(root, Config.AbortLaunchHeight)
                        return false
                    end

                    if typeof(sethiddenproperty) == "function" then
                        pcall(function()
                            sethiddenproperty(root, "PhysicsRepRootPart", crimRoot)
                        end)
                    end
                    root.CFrame = crimRoot.CFrame

                    EjectVehicleTarget(targetVehicle)

                    local currentPop = targetVehicle:GetAttribute("VehicleTiresLastPop") or 0
                    local currentTireHealth = targetVehicle:GetAttribute("VehicleTireHealth") or initialTireHealth
                    local stillInVeh = crimChar:GetAttribute("InVehicle")

                    if currentPop ~= initialPop or currentTireHealth < initialTireHealth or not stillInVeh then
                        print("[TIRE POPPED / HEALTH CHANGED / EXITED] Stopping vehicle teleport...")
                        break
                    end

                    task.wait()
                end
            end

            print("[AFTER RAMMING] Jumping out, equipping handcuffs, and chasing target on foot...")
            ForceExitVehicle() -- Changed to yielding exit function
            EquipHandcuffs()
            task.wait(Config.EquipWait)

            local char = LocalPlayer.Character
            local myRoot = char and char:FindFirstChild("HumanoidRootPart")
            if myRoot and crimRoot and crimRoot.Parent then
                flyOnFootToTargetAndBackTeleport(char, myRoot, crimPlayer, Config.OnFootFlySpeed)
            end
        end
    else
        launchUpToSafety(root, Config.AbortLaunchHeight)
        return false
    end
    
    return true
end

local function handleVehicleFlight()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local targetY = root.Position.Y + Config.VehicleHoverHeight
    
    local launchVelocity = Instance.new("BodyVelocity")
    launchVelocity.MaxForce = Vector3.new(Config.PhysicsMaxForce, Config.PhysicsMaxForce, Config.PhysicsMaxForce)
    launchVelocity.Velocity = Vector3.new(0, Config.VehicleAscentSpeed, 0)
    launchVelocity.Parent = root
    
    local launchGyro = Instance.new("BodyGyro")
    launchGyro.MaxTorque = Vector3.new(Config.PhysicsMaxForce, Config.PhysicsMaxForce, Config.PhysicsMaxForce)
    local look = root.CFrame.LookVector
    launchGyro.CFrame = CFrame.lookAt(root.Position, root.Position + Vector3.new(look.X, 0, look.Z))
    launchGyro.Parent = root

    -- 1. Initial Ascent
    while root.Parent and root.Position.Y < targetY and IsInVehicle() do
        task.wait()
    end
    
    -- 2. Master Search & Hover Loop
    while root.Parent and IsInVehicle() do
        -- Freeze vehicle in air while scanning for a target
        launchVelocity.Parent = root
        launchGyro.Parent = root
        launchVelocity.Velocity = Vector3.zero 
        
        local nearestCrim, _ = FindNearestCriminal(root)
        if nearestCrim then
            -- Target found! Temporarily un-parent hover so flyVehicleToCriminal handles physics
            launchVelocity.Parent = nil
            launchGyro.Parent = nil
            
            local success = flyVehicleToCriminal(root, nearestCrim, Config.CriminalCruiseSpeed)
            
            if not success then
                -- Chase aborted (target hid/died). Wait slightly before searching again.
                task.wait(Config.VehicleFailedWait)
            else
                -- Successfully jumped out of the vehicle and initiated on-foot phase
                break
            end
        else
            -- No valid targets on map, continue hovering indefinitely
            task.wait(Config.VehicleSearchInterval)
        end
    end

    if launchVelocity then launchVelocity:Destroy() end
    if launchGyro then launchGyro:Destroy() end

    -- 3. Manual Flight Fallback
    local cfg = rawget(getfenv(), "configs") or { 
        vehicle = { 
            fx = 0, fy = 0, fz = 0, 
            fspeed = Config.ManualFlightSpeed, 
            ftog = Config.ManualFlightEnabled 
        } 
    }
    local cl = rawget(getfenv(), "client") or { vehicleEntered = true }

    local BodyGyro = Instance.new("BodyGyro", root)
    local BodyVelocity = Instance.new("BodyVelocity", root)
    local Camera = workspace.CurrentCamera

    BodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    BodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    BodyGyro.D = 50000
    BodyGyro.P = 150000000

    repeat
        task.wait()
        if not root.Parent then break end
        BodyGyro.CFrame = Camera.CFrame * CFrame.Angles(
            math.rad(cfg.vehicle.fx or 0), 
            math.rad(cfg.vehicle.fy or 0), 
            math.rad(cfg.vehicle.fz or 0)
        )
        Camera.CameraType = Enum.CameraType.Track
        BodyVelocity.Velocity = Vector3.zero

        local playerModule = LocalPlayer.PlayerScripts:FindFirstChild("PlayerModule")
        local controlModule = playerModule and playerModule:FindFirstChild("ControlModule")
        if controlModule then
            local direction = require(controlModule):GetMoveVector()
            if direction.X > 0 then
                BodyVelocity.Velocity = BodyVelocity.Velocity + Camera.CFrame.RightVector * direction.X
            end
            if direction.X < 0 then
                BodyVelocity.Velocity = BodyVelocity.Velocity + Camera.CFrame.RightVector * direction.X
            end
            if direction.Z > 0 then
                BodyVelocity.Velocity = BodyVelocity.Velocity - Camera.CFrame.LookVector * direction.Z
            end
            if direction.Z < 0 then
                BodyVelocity.Velocity = BodyVelocity.Velocity - Camera.CFrame.LookVector * direction.Z
            end
            BodyVelocity.Velocity = BodyVelocity.Velocity * (cfg.vehicle.fspeed or Config.ManualFlightSpeed)
        end
    until not IsInVehicle() or cl.vehicleEntered == false or cfg.vehicle.ftog == false

    Camera.CameraType = Enum.CameraType.Custom
    BodyGyro:Destroy()
    BodyVelocity:Destroy()
end

local function onSpawn(char)
    if isRunning then return end
    isRunning = true
    local root = char:WaitForChild("HumanoidRootPart", 10)
    if not root then isRunning = false return end
    task.wait(Config.SpawnWait)

    if IsInVehicle() then
        handleVehicleFlight()
        isRunning = false
        return
    end

    local closestData, minDist = nil, math.huge
    for _, data in pairs(Stations) do
        local dist = (root.Position - data.Base).Magnitude
        if dist < minDist then
            minDist = dist
            closestData = data
        end
    end

    if closestData then
        for _, wp in ipairs(closestData.Path) do
            if not char.Parent or not root.Parent or IsInVehicle() then break end
            char:PivotTo(CFrame.new(wp))
            task.wait(Config.WaypointWait)
        end
    end

    local blacklisted = {}
    while char.Parent and root.Parent and not IsInVehicle() do
        local nearestVeh = FindNearestVehicle(root, blacklisted)
        if not nearestVeh then break end
        
        flyToPos(char, root, nearestVeh:GetPivot().Position)
        if IsInVehicle() then break end
        
        task.wait(Config.FlyStepWait)
        
        for _ = 1, Config.EnterVehicleRetries do
            enterVehicle(root)
            task.wait(Config.EnterVehicleWait)
            if IsInVehicle() then break end
        end

        if IsInVehicle() then
            handleVehicleFlight()
            break
        else
            blacklisted[nearestVeh] = true
        end
    end
    isRunning = false
end

LocalPlayer.CharacterAdded:Connect(onSpawn)
if LocalPlayer.Character then task.spawn(onSpawn, LocalPlayer.Character) end
