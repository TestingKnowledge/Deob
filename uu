    print("[SERVER HOP]",reason)
    if renderConnection then
        renderConnection:Disconnect()
        renderConnection=nil
    end
    local servers=GetServerList()
    if servers then
        local target=nil
        for _,server in pairs(servers) do
            if server.playing>=Config.ServerHopMinPlayers and server.playing<=Config.ServerHopMaxPlayers and server.playing<server.maxPlayers then
                target=server
                break
            end
        end
        if target then
            print("[SERVER HOP] Joining server:",target.playing.."/"..target.maxPlayers)
            local options=Instance.new("TeleportOptions")
            options.ServerInstanceId=target.id
            local ok,err=pcall(function()
                TeleportService:TeleportAsync(game.PlaceId,{LocalPlayer},options)
            end)
            if ok then
                return
            end
            warn("[SERVER HOP] Teleport failed:",err)
        end
    end
    ServerHopActive=false
    print("[SERVER HOP] No suitable server found, using normal teleport.")
    pcall(function()
