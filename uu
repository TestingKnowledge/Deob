local function FindNearestAvailableVehicle(rootPart,radius)
    local folder=workspace:FindFirstChild("Vehicles")
    if not folder or not rootPart then
        return nil,nil
    end
    local best,bestDist=nil,math.huge
    local maxRadius=radius or Config.Phase1VehicleSearchRadius
    for _,v in ipairs(folder:GetChildren()) do
        local seat=v:FindFirstChild("Seat") or v:FindFirstChild("VehicleSeat")
        if seat and (seat:IsA("Seat") or seat:IsA("VehicleSeat")) and not seat.Occupant then
            local driver=v:FindFirstChild("Driver")
            if not driver then
                driver=v:FindFirstChild("Driver",true)
            end
            if not driver or not driver:IsA("ObjectValue") or not driver.Value then
                local dist=(seat.Position-rootPart.Position).Magnitude
                if dist<=maxRadius and dist<bestDist then
                    best=v
                    bestDist=dist
                end
            end
        end
    end
    return best,bestDist
end
local function IsObstacleAbove(rootPart,distance,vehicle)
    if not rootPart or not rootPart.Parent then
        return true
    end
    local rayParams=RaycastParams.new()
    rayParams.FilterType=Enum.RaycastFilterType.Exclude
    local ignoreList={LocalPlayer.Character}
    if vehicle and vehicle.Parent then
        table.insert(ignoreList,vehicle)
    end
    rayParams.FilterDescendantsInstances=ignoreList
    rayParams.IgnoreWater=true
    local result=workspace:Raycast(
        rootPart.Position,
        Vector3.new(0,distance or Config.CeilingCheckRayDistance,0),
        rayParams
    )
    if result and result.Instance and result.Instance.CanCollide then
        return true
    end
    return false
end
