    local followStuckSince=tick()
    renderConnection=RunService.RenderStepped:Connect(function()
        if not getgenv().AutoArrestActive or not isTargetValid(targetRoot) then
            linearVelocity.VectorVelocity=Vector3.zero
            return
        end
        if CheckLagback(rootPart) then
            linearVelocity.VectorVelocity=Vector3.zero
            return
        end
        local moved=(rootPart.Position-followLastPos).Magnitude
        if moved>=Config.AntiStuckMinMove then
            followLastPos=rootPart.Position
            followStuckSince=tick()
        elseif tick()-followStuckSince>=Config.AntiStuckTimeout then
            linearVelocity.VectorVelocity=Vector3.zero
            ResetCharacter("anti-stuck while following target")
            return
        end
        local offset=targetRoot.Position-rootPart.Position
        local dist=offset.Magnitude
        if dist>Config.PlayerFlyStopDistance then
            local velocity=offset.Unit*Config.PlayerFlySpeed
            local _,peak,mountainFound,forwardDist=ScanTerrainAhead(rootPart,velocity)
            if mountainFound and forwardDist<250 then
                local desiredY=peak+20
                local yDiff=desiredY-rootPart.Position.Y
                local vy=math.clamp(yDiff*6,-350,170)
                if yDiff>1 then vy=math.clamp(yDiff*6,25,170) end
                if yDiff<-1 then vy=-math.clamp(math.abs(yDiff)*4,20,350) end
                velocity=Vector3.new(velocity.X,vy,velocity.Z)
            end
            linearVelocity.VectorVelocity=velocity
        else
            linearVelocity.VectorVelocity=Vector3.zero
        end
    end)
    local arrestLastPos=rootPart.Position
    local arrestStuckSince=tick()
    while getgenv().AutoArrestActive and isTargetValid(targetRoot) do
        local arrestMoved=(rootPart.Position-arrestLastPos).Magnitude
        if arrestMoved>=Config.AntiStuckMinMove then
            arrestLastPos=rootPart.Position
            arrestStuckSince=tick()
        elseif tick()-arrestStuckSince>=Config.AntiStuckTimeout then
            ResetCharacter("anti-stuck during arrest")
            return
        end
        if ReturnToLastExitedCar(rootPart,char,humanoid) then
            print("[FOLLOW SAFETY] Back at last car. Restarting target cycle from the vehicle.")
            return
        end
        if CheckLagback(rootPart) then
            break
        end
        local dist=(rootPart.Position-targetRoot.Position).Magnitude
        if dist<=Config.ArrestTpDistance then
            pcall(function()
                sethiddenproperty(rootPart,"PhysicsRepRootPart",targetRoot)
            end)
            if humanoid then
                humanoid.Sit=false
            end
            rootPart.CFrame=targetRoot.CFrame*CFrame.new(0,3,2)*Config.TpOffset
            EquipHandcuffs()
            task.wait(0.1)
            local targetChar=targetRoot.Parent
            local targetPlayerObj=Players:GetPlayerFromCharacter(targetChar)
            ExitAccidentalVehicle(humanoid)
            if targetChar:GetAttribute("InVehicle") then
                EjectNearestVehicleUser(targetRoot)
            else
                if attemptArrest and targetPlayerObj then
                    pcall(function()
                        attemptArrest(targetPlayerObj)
                    end)
                end
            end
            if targetChar:GetAttribute("HasHandcuffs") then
                print("[HANDCUFFED]",targetChar.Name)
                if targetPlayerObj then
                    arrestedBlacklist[targetPlayerObj]=true
                end
                break
            end
        end
        task.wait()
    end
    UnequipHandcuffs()
    if renderConnection then
        renderConnection:Disconnect()
        renderConnection=nil
    end
    if linearVelocity then
        linearVelocity:Destroy()
    end
    if attachment then
        attachment:Destroy()
    end
    task.wait(0.5)
end
ExecuteAutoArrest=function()
    if ScriptDead then
        return
    end
    if CheckServerHop() then
        return
    end
    getgenv().AutoArrestActive=true
    getgenv().LagbackCount=0
    phase1Complete=false
    phase1PathComplete=false
    phase1FinalPosition=nil
    resetQueued=false
    print("[AUTO ARREST] Starting execution - PHASE 1")
    local initChar=LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local initRoot=initChar:WaitForChild("HumanoidRootPart")
    local initHum=initChar:WaitForChild("Humanoid")
    print("[PHASE 1] Running destination path. No vehicle search or upward flight until it finishes.")
    while getgenv().AutoArrestActive and LocalPlayer.Character==initChar and not phase1Complete do
        if not GoToClosestStationAndGetCar(initRoot,initChar,initHum) then
            if not getgenv().AutoArrestActive or LocalPlayer.Character~=initChar then
                return
            end
            task.wait(1)
        end
    end
    if not phase1Complete or not getgenv().AutoArrestActive or LocalPlayer.Character~=initChar then
        return
    end
    print("[PHASE 1 COMPLETE] Vehicle secured. Auto-arrest cycle unlocked.")
    while getgenv().AutoArrestActive and LocalPlayer.Character==initChar do
        ExecuteAutoArrestCycle()
        task.wait()
    end
end

local function Shutdown(reason)
    if ScriptDead then return end
    ScriptDead=true
    getgenv().AutoArrestActive=false
    print("[SHUTDOWN]",reason or "stopped")
    local me=coroutine.running()
    for _,th in ipairs(Threads) do
        if th~=me then pcall(task.cancel,th) end
    end
    table.clear(Threads)
    if renderConnection then
        pcall(function() renderConnection:Disconnect() end)
    end
    for _,conn in ipairs(Connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(Connections)
    for _,inst in ipairs(Instances) do
        pcall(function() inst:Destroy() end)
    end
    table.clear(Instances)
    pcall(function()
        VirtualInputManager:SendKeyEvent(false,Enum.KeyCode.Space,false,game)
    end)
    local char=LocalPlayer.Character
    local root=char and char:FindFirstChild("HumanoidRootPart")
    if root then
        pcall(function()
            root.AssemblyLinearVelocity=Vector3.zero
            root.AssemblyAngularVelocity=Vector3.zero
        end)
    end
    renderConnection=nil
    currentTarget=nil
    targetRoot=nil
    phase1Complete=false
    phase1PathComplete=false
    phase1FinalPosition=nil
    lastCarExited=nil
    rememberedCar=nil
    resetQueued=false
    ServerHopActive=false
    ExitFunc=nil
    attemptArrest=nil
    ExecuteAutoArrest=nil
    vehicleUtils=nil
    Modules=nil
    table.clear(arrestedBlacklist)
    getgenv().GetMyCar=nil
    getgenv().LagbackCount=nil
    getgenv().AutoArrestActive=nil
end
local startChar=LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local startHum=startChar:WaitForChild("Humanoid",10)
Track(LocalPlayer.CharacterRemoving:Connect(function()
    Shutdown("character removed")
end))
Track(LocalPlayer.CharacterAdded:Connect(function()
    Shutdown("respawned")
end))
if startHum and startHum.Health>0 then
    Track(startHum.Died:Connect(function()
        Shutdown("died")
    end))
    Spawn(ExecuteAutoArrest)
else
    Shutdown("no live character")
end
