local function EquipHandcuffs()
    if not invSys then return false end
    local success = false

    pcall(function()
        for _, item in pairs(invSys.getInventoryItemsFor(LocalPlayer)) do
            if item.obj and item.obj.Name == "Handcuffs" then    
                item:AttemptSetEquipped(true)    
                success = true    
                break    
            end    
        end
    end)

    return success
end

local function UnequipHandcuffs()
    if not invSys then return false end
    local success = false

    pcall(function()
        for _, item in pairs(invSys.getInventoryItemsFor(LocalPlayer)) do
            if item.obj and item.obj.Name == "Handcuffs" then    
                item:AttemptSetEquipped(false)    
                success = true    
                break    
            end    
        end
    end)

    return success
end

local function EjectVehicleTarget(targetVeh, crimPlayer)
    if not targetVeh or not crimPlayer then return end

    local UI
    pcall(function()
        UI = require(ReplicatedStorage.Module.UI)
    end)

    if not UI or not UI.CircleAction or not UI.CircleAction.Specs then return end

    local start = tick()
    while crimPlayer and crimPlayer.Character and crimPlayer.Character:GetAttribute("InVehicle") == true and (tick() - start < 1.2) do
        for _, spec in pairs(UI.CircleAction.Specs) do
            local isMatch = false
            if spec.Part and (targetVeh:IsAncestorOf(spec.Part) or spec.Part:IsDescendantOf(targetVeh)) then
                isMatch = true
            elseif spec.Text and (spec.Text:lower():find("eject") or spec.Text:lower():find("passenger")) then
                isMatch = true
            end

            if isMatch then
                pcall(function() spec:Callback(true) end)
            end
        end
        task.wait(0.05)
    end
end

local function ArrestTarget(targetPlayer)
    if attemptArrest and targetPlayer then
        pcall(function()
            attemptArrest(targetPlayer)
        end)
    end
end

local function isTargetValid(targetRoot)
    if not targetRoot or not targetRoot.Parent then
        return false
    end

    local plr = Players:GetPlayerFromCharacter(targetRoot.Parent)

    if not plr or not plr.Team or plr.Team.Name ~= "Criminal" then
        return false
    end

    if targetRoot.Position.Y < 5 then
        return false
    end

    return true
end

local function IsPursuitTargetValid(crimPlayer)
    if not crimPlayer or crimPlayer == LocalPlayer then
        return false
    end

    if not crimPlayer.Parent then
        return false
    end

    if not crimPlayer.Team or crimPlayer.Team.Name ~= "Criminal" then
        return false
    end

    local crimChar = crimPlayer.Character
    local crimRoot = crimChar and crimChar:FindFirstChild("HumanoidRootPart")

    if not crimChar or not crimChar.Parent or not crimRoot or not crimRoot.Parent then
        return false
    end

    if not isTargetValid(crimRoot) then
        return false
    end

    if IsUndergroundOrIndoor(crimChar) then
        return false
    end

    return true
end

local function ReturnToSavedCar()
    print("[RETURN TO CAR] Attempting to return to saved vehicle...")

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if not root then
        print("[RETURN TO CAR] No character root!")
        return false
    end

    local myCar = GetMyCar()

    if not myCar or not myCar.Parent then
        print("[RETURN TO CAR] Saved car not found or destroyed!")
        return false
    end

    print("[RETURN TO CAR] Found saved car: " .. myCar:GetFullName())

    UnequipHandcuffs()
    StopFling(char)
    StopFling(myCar)
    task.wait(0.1)

    print("[RETURN TO CAR] Ascending to return altitude...")

    cleanupOldMotion(root)

    local upLv, upAttachment = createLinearMover(root)

    if not upLv then return false end

    local targetY = root.Position.Y + 100
    local start = tick()

    while root and root.Parent and root.Position.Y < targetY and not IsInVehicle() do
        upLv.VectorVelocity = Vector3.new(0, Config.UpSpeed, 0)    

        if tick() - start > 10 then break end    

        task.wait()
    end

    destroyMover(upLv, upAttachment)

    if IsInVehicle() then
        StopFling(char)
        StopFling(myCar)
        return true
    end

    print("[RETURN TO CAR] Cruising to car position...")

    local carPos = myCar:GetPivot().Position
    local cruiseCarPos = Vector3.new(carPos.X, root.Position.Y, carPos.Z)

    cleanupOldMotion(root)

    local lv, attachment = createLinearMover(root)
    local bg = createFlightGyro(root)

    if not lv then return false end

    while root and root.Parent and myCar and myCar.Parent and not IsInVehicle() do
        local diff = cruiseCarPos - root.Position    
        local dist = diff.Magnitude    

        if dist <= 5 then break end    

        lv.VectorVelocity = diff.Unit * Config.CruiseSpeed    

        if bg then    
            bg.CFrame = CFrame.lookAt(root.Position, cruiseCarPos)    
        end    

        task.wait()
    end

    print("[RETURN TO CAR] Descending beneath car...")

    while root and root.Parent and myCar and myCar.Parent and not IsInVehicle() do
        local descendCarPos = myCar:GetPivot().Position + Vector3.new(0, Config.DownOffset, 0)    
        local diff = descendCarPos - root.Position    

        if diff.Magnitude <= 5 then break end    

        lv.VectorVelocity = diff.Unit * Config.DownSpeed    

        if bg then    
            bg.CFrame = CFrame.lookAt(root.Position, descendCarPos)    
        end    

        task.wait()
    end

    destroyMover(lv, attachment, bg)

    print("[RETURN TO CAR] Entering vehicle...")

    for i = 1, 5 do
        if IsInVehicle() then
            print("[RETURN TO CAR] Successfully entered car!")
            StopFling(char)
            StopFling(myCar)
            return true
        end

        enterVehicle(root)    
        task.wait(0.3)
    end

    if IsInVehicle() then
        print("[RETURN TO CAR] Car entered successfully!")
        StopFling(char)
        StopFling(myCar)
        return true
    end

    print("[RETURN TO CAR] Failed to enter car after 5 attempts")
    return false
end

local function flyToPos(char, root, targetPos)
    if IsInVehicle() then return end

    cleanupOldMotion(root)

    local lv, attachment = createLinearMover(root)
    local bg = createFlightGyro(root)

    if not lv then return end

    local function moveTo(dest, speed)
        while char.Parent and root.Parent and not IsInVehicle() do
            local diff = dest - root.Position    
            local dist = diff.Magnitude    

            if dist <= 3 then break end    

            lv.VectorVelocity = diff.Unit * speed    

            if bg then    
                bg.CFrame = CFrame.lookAt(root.Position, dest)    
            end    

            task.wait()    
        end
    end

    local upPos = root.Position + Vector3.new(0, Config.UpHeight, 0)
    local cruisePos = Vector3.new(targetPos.X, upPos.Y, targetPos.Z)
    local downPos = targetPos + Vector3.new(0, Config.DownOffset, 0)

    moveTo(upPos, Config.UpSpeed)
    moveTo(cruisePos, Config.CruiseSpeed)
    moveTo(downPos, Config.DownSpeed)

    destroyMover(lv, attachment, bg)
end

local function flyOnFootToTargetAndArrest(char, root, crimPlayer, speed)
    print("[PURSUIT] Starting on-foot pursuit of criminal...")
    print("[PURSUIT] 10-second timeout active")

    if not char or not root or not root.Parent then
        print("[PURSUIT] Character or root is nil!")    
        return false
    end

    if not IsPursuitTargetValid(crimPlayer) then
        print("[PURSUIT ABORT] Target is already invalid/covered")
        return false
    end

    local crimChar = crimPlayer.Character
    local targetRoot = crimChar and crimChar:FindFirstChild("HumanoidRootPart")

    if not targetRoot then
        print("[PURSUIT] Target root disappeared, aborting")
        return false
    end

    cleanupOldMotion(root)

    local lv, attachment = createLinearMover(root)
    local bg = createFlightGyro(root)

    if not lv then return false end

    local pursuitStart = tick()
    local pursuitTimeout = 10
    local arrestedFlag = false

    while char and char.Parent and root and root.Parent and targetRoot and targetRoot.Parent and not IsInVehicle() do
        if tick() - pursuitStart > pursuitTimeout then    
            print("[PURSUIT TIMEOUT] 10 seconds elapsed, aborting pursuit!")    
            break    
        end    

        if not IsPursuitTargetValid(crimPlayer) then    
            print("[PURSUIT ABORT] Target became invalid or entered cover!")    
            break    
        end    

        crimChar = crimPlayer.Character    
        targetRoot = crimChar and crimChar:FindFirstChild("HumanoidRootPart")    

        if not targetRoot then    
            print("[PURSUIT ABORT] Target root disappeared!")    
            break    
        end    

        if crimChar:GetAttribute("HasHandcuffs") then    
            print("[PURSUIT SUCCESS] Target arrested!")    
            arrestedFlag = true    
            break    
        end    

        local diff = targetRoot.Position - root.Position    

        if diff.Magnitude > 0.05 then    
            lv.VectorVelocity = diff.Unit * speed    
            if bg then    
                bg.CFrame = CFrame.lookAt(root.Position, targetRoot.Position)    
            end    
        else    
            lv.VectorVelocity = Vector3.zero    
        end    

        -- SPAM HANDCUFFS & ARREST
        EquipHandcuffs()    
        ArrestTarget(crimPlayer)    

        task.wait(0.03)
    end

    if lv then lv.VectorVelocity = Vector3.zero end
    destroyMover(lv, attachment, bg)

    if arrestedFlag or (crimChar and crimChar:GetAttribute("HasHandcuffs")) then
        print("[PURSUIT] Arrested! Unequipping handcuffs immediately...")
        task.wait(0.1)    
        UnequipHandcuffs()    
        print("[PURSUIT] Handcuffs unequipped")    
        return true
    end

    print("[PURSUIT] On-foot pursuit ended without arrest")
    return false
end

local function flyVehicleToCriminal(root, crimPlayer, speed)
    print("[VEHICLE] Starting pursuit of criminal in vehicle...")

    if not IsPursuitTargetValid(crimPlayer) then
        print("[VEHICLE ABORT] Target invalid before pursuit")
        return false
    end

    local crimChar = crimPlayer.Character
    local crimRoot = crimChar and crimChar:FindFirstChild("HumanoidRootPart")

    if not crimRoot then
        print("[VEHICLE] Target root disappeared, aborting")
        return false
    end

    local targetInVeh = crimChar:GetAttribute("InVehicle") == true
    local stopDistance = targetInVeh and Config.TeleportDistance or Config.OnFootDescendDistance
    local aborted = false

    cleanupOldMotion(root)

    local lv, attachment = createLinearMover(root)
    local bg = createFlightGyro(root)

    if not lv then return false end

    print("[VEHICLE] Flying overhead to target...")

    while root.Parent and IsInVehicle() and crimRoot and crimRoot.Parent do
        if not IsPursuitTargetValid(crimPlayer) then    
            print("[VEHICLE ABORT] Target invalid during cruise!")    
            aborted = true    
            break    
        end    

        crimChar = crimPlayer.Character    
        crimRoot = crimChar and crimChar:FindFirstChild("HumanoidRootPart")    

        if not crimRoot then    
            aborted = true    
            break    
        end    

        local targetPos = crimRoot.Position    
        local overheadPos = Vector3.new(targetPos.X, root.Position.Y, targetPos.Z)    
        local diff = overheadPos - root.Position    
        local dist = diff.Magnitude    

        if dist <= 4 then    
            lv.VectorVelocity = Vector3.zero    
            break    
        end    

        lv.VectorVelocity = diff.Unit * speed    

        if bg then    
            bg.CFrame = CFrame.lookAt(root.Position, overheadPos)    
        end    

        task.wait()
    end

    if not aborted then
        print("[VEHICLE] Descending towards target...")

        while root.Parent and IsInVehicle() and crimRoot and crimRoot.Parent do    
            if not IsPursuitTargetValid(crimPlayer) then    
                print("[VEHICLE ABORT] Target invalid during descent!")    
                aborted = true    
                break    
            end    

            crimChar = crimPlayer.Character    
            crimRoot = crimChar and crimChar:FindFirstChild("HumanoidRootPart")    

            if not crimRoot then    
                aborted = true    
                break    
            end    

            local currentTarget = crimRoot.Position    
            local currentDist = (root.Position - currentTarget).Magnitude    

            if currentDist <= stopDistance then    
                print("[VEHICLE] Reached stop distance: " .. string.format("%.2f", currentDist))    
                break    
            end    

            local diff = currentTarget - root.Position    

            if diff.Magnitude <= 0.05 then    
                lv.VectorVelocity = Vector3.zero    
            else    
                lv.VectorVelocity = diff.Unit * speed    
            end    

            if bg then    
                bg.CFrame = CFrame.lookAt(root.Position, currentTarget)    
            end    

            task.wait()    
        end
    end

    destroyMover(lv, attachment, bg)

    if aborted or not IsPursuitTargetValid(crimPlayer) then
        print("[VEHICLE ABORT] Target became invalid or covered; remaining in vehicle")
        return false
    end

    crimChar = crimPlayer.Character
    crimRoot = crimChar and crimChar:FindFirstChild("HumanoidRootPart")

    if crimRoot and crimRoot.Parent then
        if not targetInVeh then    
            print("[VEHICLE] Target on foot, exiting vehicle safely...")    

            SafelyExitVehicle()    
            EquipHandcuffs()    

            task.wait(0.2)    

            local char = LocalPlayer.Character    
            local myRoot = char and char:FindFirstChild("HumanoidRootPart")    
            local arrestSuccess = false

            if myRoot and crimRoot and crimRoot.Parent then    
                arrestSuccess = flyOnFootToTargetAndArrest(char, myRoot, crimPlayer, Config.OnFootFlySpeed)    
            end    

            if not IsInVehicle() then
                print("[ARREST CYCLE END] Returning to saved vehicle...")
                ReturnToSavedCar()
            end

            return arrestSuccess

        else    
            print("[VEHICLE] Target in vehicle, ramming and ejecting...")    
            local targetVehicle = GetTargetVehicle(crimChar)    

            if targetVehicle then    
                local initialPop = targetVehicle:GetAttribute("VehicleTiresLastPop")    
                local rStart = tick()    
                local maxRamTime = 0.1    

                while root and root.Parent and IsInVehicle() and crimRoot and crimRoot.Parent and (tick() - rStart < maxRamTime) do    
                    if not IsPursuitTargetValid(crimPlayer) then break end    

                    if typeof(sethiddenproperty) == "function" then    
                        pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", crimRoot) end)    
                    end    

                    root.CFrame = crimRoot.CFrame * CFrame.new(0, 0, 5)    

                    -- Continuous Eject Spam targeting specifically target's vehicle
                    EjectVehicleTarget(targetVehicle, crimPlayer)

                    local currentPop = targetVehicle:GetAttribute("VehicleTiresLastPop")    
                    if (currentPop and initialPop and currentPop ~= initialPop) or (crimChar:GetAttribute("InVehicle") ~= true) then    
                        print("[EJECT / TIRE POPPED] Breaking ram loop...")    
                        task.wait(0.1)    
                        break    
                    end    

                    task.wait()    
                end    
                task.wait(0.1)    
            end    

            print("[AFTER RAMMING] Safely exiting vehicle and pursuing target on foot...")    

            SafelyExitVehicle()    
            EquipHandcuffs()    

            task.wait(0.2)    

            local char = LocalPlayer.Character    
            local myRoot = char and char:FindFirstChild("HumanoidRootPart")    
            local arrestSuccess = false

            if myRoot and crimRoot and crimRoot.Parent then    
                arrestSuccess = flyOnFootToTargetAndArrest(char, myRoot, crimPlayer, Config.OnFootFlySpeed)    
            end    

            if not IsInVehicle() then
                print("[ARREST CYCLE END] Returning to saved vehicle...")
                ReturnToSavedCar()
            end

            return arrestSuccess
        end
    end

    return false
end

local function handleVehicleFlight()
    print("[FLIGHT] Starting vehicle flight handler...")

    UpdateRememberedCar()

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if not root then
        print("[FLIGHT] Root not found!")
        return
    end

    cleanupOldMotion(root)

    local flightAltitude = root.Position.Y + Config.FlightAltitude
    print("[FLIGHT] Safe flight altitude: " .. string.format("%.2f", flightAltitude))
    print("[FLIGHT] Launching to fixed 500-stud altitude...")

    local hover = moveToFlightAltitude(root, flightAltitude, Config.AltitudeCorrectionSpeed)

    if not root.Parent or not IsInVehicle() then
        if hover then destroyMover(hover.lv, hover.attachment, hover.bg) end    
        return
    end

    print("[FLIGHT] Reached safe 500-stud altitude")
    print("[FLIGHT] Starting criminal search loop...")

    while root.Parent and IsInVehicle() do
        maintainFlightHover(root, hover, flightAltitude)

        local nearestCrim, crimDist = FindNearestCriminal(root)    

        if nearestCrim then    
            print("[FLIGHT] Found criminal at distance: " .. crimDist)    

            if hover then    
                destroyMover(hover.lv, hover.attachment, hover.bg)    
                hover = nil    
            end    

            local success = flyVehicleToCriminal(root, nearestCrim, Config.CriminalCruiseSpeed)    

            if not IsInVehicle() then
                print("[FLIGHT] Player on foot after pursuit; returning to saved car...")
                ReturnToSavedCar()
            end

            if root.Parent and IsInVehicle() then    
                print("[FLIGHT] Pursuit complete/aborted; restoring fixed 500-stud hover...")    
                hover = moveToFlightAltitude(root, flightAltitude, Config.AltitudeCorrectionSpeed)    

                if not hover then    
                    print("[FLIGHT] Failed to restore hover; ending vehicle flight")    
                    break    
                end    
            else    
                break    
            end    

            if success then    
                print("[FLIGHT] Arrest successful! Searching for next target...")    
            else    
                print("[FLIGHT] Pursuit failed/aborted; remaining at 500 studs")    
            end    

            task.wait(0.5)    

        else    
            if not hover then    
                hover = moveToFlightAltitude(root, flightAltitude, Config.AltitudeCorrectionSpeed)    
            else    
                maintainFlightHover(root, hover, flightAltitude)    
            end    

            task.wait(1)    
        end
    end

    if hover then
        destroyMover(hover.lv, hover.attachment, hover.bg)
        hover = nil
    end

    if not root.Parent then
        cleanupOldMotion(root)
        return
    end

    if not IsInVehicle() then
        cleanupOldMotion(root)
        print("[FLIGHT] Vehicle flight ended because player left vehicle")
        return
    end

    print("[FLIGHT] Flight handler ended")
end

local function onSpawn(char)
    if isRunning then
        print("[SPAWN] Script already running, waiting for previous spawn to finish...")
        task.wait(2)
    end

    isRunning = true
    print("[SPAWN] Player spawned, initializing...")

    local root = char:WaitForChild("HumanoidRootPart", 10)

    if not root then
        print("[SPAWN] Failed to get HumanoidRootPart!")
        isRunning = false    
        return
    end

    task.wait(1)

    pcall(function()
        cleanupOldMotion(root)

        if IsInVehicle() then    
            print("[SPAWN] Player in vehicle at spawn, starting vehicle flight...")    
            UpdateRememberedCar()    
            handleVehicleFlight()    
            return    
        end    

        print("[SPAWN] Finding closest station...")    

        local closestData, minDist = nil, math.huge    

        for _, data in pairs(Stations) do    
            local dist = (root.Position - data.Base).Magnitude    
            if dist < minDist then    
                minDist = dist    
                closestData = data    
            end    
        end    

        if closestData then    
            print("[SPAWN] Moving to closest station, distance: " .. minDist)    

            for _, wp in ipairs(closestData.Path) do    
                if not char.Parent or not root.Parent or IsInVehicle() then break end    
                char:PivotTo(CFrame.new(wp))    
                task.wait(0.2)    
            end    
        end    

        print("[SPAWN] Searching for vehicle...")    
        local blacklisted = {}    

        while char.Parent and root.Parent and not IsInVehicle() do    
            local nearestVeh = FindNearestCamaroOrJeep(root, blacklisted)    

            if not nearestVeh then    
                print("[SPAWN] No more vehicles found!")    
                break    
            end    

            print("[SPAWN] Found vehicle at distance: " .. (nearestVeh:GetPivot().Position - root.Position).Magnitude)    

            flyToPos(char, root, nearestVeh:GetPivot().Position)    

            if IsInVehicle() then break end    

            task.wait(0.1)    

            local entered = false    

            for i = 1, 5 do    
                print("[SPAWN] Entering vehicle attempt " .. i)    
                enterVehicle(root)    
                task.wait(0.3)    

                if IsInVehicle() then    
                    entered = true    
                    break    
                end    
            end    

            if entered or IsInVehicle() then    
                print("[SPAWN] Successfully entered vehicle!")    
                task.wait(0.2)    
                UpdateRememberedCar()    
                handleVehicleFlight()    
                break    
            else    
                print("[SPAWN] Failed to enter vehicle, blacklisting...")    
                blacklisted[nearestVeh] = true    
            end    
        end    

        print("[SPAWN] Spawn sequence completed")
    end)

    isRunning = false
    print("[SPAWN] Spawn flag reset")
end

LocalPlayer.CharacterAdded:Connect(onSpawn)

if LocalPlayer.Character then
    task.spawn(onSpawn, LocalPlayer.Character)
end
