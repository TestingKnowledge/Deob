local function GetCurrentVehicle()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local seat = hum and hum.SeatPart
    if seat then
        return seat:FindFirstAncestorOfClass("Model") or seat.Parent
    end
    return nil
end

local function GetTargetVehicle(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local seat = hum and hum.SeatPart
    if seat then
        return seat:FindFirstAncestorOfClass("Model") or seat.Parent
    end
    if workspace:FindFirstChild("Vehicles") then
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            for _, v in ipairs(workspace.Vehicles:GetChildren()) do
                if (v:GetPivot().Position - root.Position).Magnitude < 15 then
                    return v
                end
            end
        end
    end
    return nil
end

local function IsInVehicle()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return (hum and (hum.Sit or hum.SeatPart ~= nil)) or (GetCurrentVehicle() ~= nil)
end

local function IsUndergroundOrIndoor(character)
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return true end

    if root.Position.Y < 5 then return true end

    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {character, LocalPlayer.Character, workspace:FindFirstChild("Vehicles")}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude

    local rayResult = workspace:Raycast(root.Position, Vector3.new(0, 150, 0), raycastParams)
    if rayResult and rayResult.Instance then
        return true
    end

    return false
end

local function FindNearestCriminal(root, radius)
    local nearest, dist = nil, radius or math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Team and p.Team.Name == "Criminal" then
            local c = p.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            if r and not IsUndergroundOrIndoor(c) then
                local d = (r.Position - root.Position).Magnitude
                if d < dist then nearest, dist = p, d end
            end
        end
    end
    return nearest, dist
end

local function FindNearestCamaroOrJeep(root, blacklisted)
    local nearest, dist = nil, math.huge
    for _, v in ipairs(workspace.Vehicles:GetChildren()) do
        if not blacklisted[v] then
            local n = v.Name:lower()
            if n:find("camaro",1,true) or n:find("jeep",1,true) then
                local p = v:GetPivot().Position
                local d = (p - root.Position).Magnitude
                if d < dist then nearest, dist = v, d end
            end
        end
    end
    return nearest, dist
end

local function enterVehicle(root)
    local UI = require(ReplicatedStorage.Module.UI)
    for _, v in pairs(workspace.Vehicles:GetChildren()) do
        if v:FindFirstChild("Seat") and (v.Seat.Position - root.Position).Magnitude < 15 then
            for _, spec in pairs(UI.CircleAction.Specs) do
                if spec.Part and spec.Part == v.Seat then
                    spec:Callback(true)
                    break
                end
            end
            break
        end
    end
end

