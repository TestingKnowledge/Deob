local function IsTargetCovered(root)
    if not root then
        return true
    end
    local rayParams=RaycastParams.new()
    rayParams.FilterType=Enum.RaycastFilterType.Exclude
    local ignoreList={LocalPlayer.Character,root.Parent}
    if workspace:FindFirstChild("Vehicles") then
        table.insert(ignoreList,workspace.Vehicles)
    end
    rayParams.FilterDescendantsInstances=ignoreList
    rayParams.IgnoreWater=true
    local rayResult=workspace:Raycast(
        root.Position,
        Vector3.new(0,Config.CeilingCheckRayDistance,0),
        rayParams
    )
    if rayResult and rayResult.Instance and rayResult.Instance.CanCollide then
        return true
    end
    return false
end
local function isTargetValid(root)
    if not root or not root.Parent then
        return false
    end
    local plr=Players:GetPlayerFromCharacter(root.Parent)
    if not plr or arrestedBlacklist[plr] then
        return false
    end
    if plr.Team and plr.Team.Name~="Criminal" then
        return false
    end
    local char=root.Parent
    if char:GetAttribute("HasHandcuffs") then
        return false
    end
    if root.Position.Y<Config.UndergroundYThreshold then
        return false
    end
    if IsTargetCovered(root) then
        return false
    end
    if char:GetAttribute("InVehicle") then
        local vehiclesDir=workspace:FindFirstChild("Vehicles")
        if vehiclesDir then
            for _,v in pairs(vehiclesDir:GetChildren()) do
                local seat=v:FindFirstChild("Seat") or v:FindFirstChild("VehicleSeat") or v:FindFirstChildWhichIsA("BasePart",true)
                if seat and (seat.Position-root.Position).Magnitude<15 then
                    local vName=v.Name:lower()
                    if vName:find("heli") or vName:find("drone") or vName:find("blimp") then
                        return false
                    end
                end
            end
        end
    end
    return true
end
local function getClosestCriminal(p_root)
    local bestRoot,bestDist=nil,math.huge
    local selectedPlr
    for _,plr in pairs(Players:GetPlayers()) do
        if plr~=LocalPlayer and plr.Character and not arrestedBlacklist[plr] then
            if plr.Team and plr.Team.Name=="Criminal" then
                local root=plr.Character:FindFirstChild("HumanoidRootPart")
                if isTargetValid(root) then
                    local d=(root.Position-p_root.Position).Magnitude
                    if d<bestDist then
                        bestDist=d
                        bestRoot=root
                        selectedPlr=plr
                    end
                end
            end
        end
    end
    return selectedPlr,bestRoot
end
local function ScanTerrainAhead(rootPart,checkDirection)
    if not rootPart or not rootPart.Parent then
        return rootPart and rootPart.Position.Y or 0,rootPart and rootPart.Position.Y or 0,false,0
    end
    local dirUnit=(checkDirection and checkDirection.Magnitude>0.1) and checkDirection.Unit or rootPart.CFrame.LookVector
    local origin=rootPart.Position
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances={workspace.Terrain}
    local groundRay=workspace:Raycast(origin+Vector3.new(0,10,0),Vector3.new(0,-2000,0),params)
    local groundY=groundRay and groundRay.Position.Y or origin.Y-5
    local distances={15,40,80,130,180,250}
    local highest=groundY
    local found=false
    local direct=workspace:Raycast(origin,dirUnit*250,params)
    local hitDist=direct and (direct.Position-origin).Magnitude or 250
    if direct then table.insert(distances,math.max(1,hitDist)) end
    local skyY=math.max(origin.Y+1500,2000)
    for _,dist in ipairs(distances) do
        local point=origin+dirUnit*dist
        local hit=workspace:Raycast(Vector3.new(point.X,skyY,point.Z),Vector3.new(0,-4000,0),params)
        if hit then
            highest=math.max(highest,hit.Position.Y)
            if (hit.Position.Y-groundY)>=20 or (hit.Position.Y-origin.Y)>=20 then
                found=true
            end
        end
    end
    return groundY,highest,found,hitDist
end
function FlyPlayerTo(rootPart,targetPos,stopDist,speed,useTerrain)
    if not rootPart or not rootPart.Parent then
        return
    end
    if rootPart:FindFirstChild("ExecFlyAttachment") then rootPart.ExecFlyAttachment:Destroy() end
    if rootPart:FindFirstChild("ExecFlyVelocity") then rootPart.ExecFlyVelocity:Destroy() end
    local attachment=Mk("Attachment",rootPart)
    attachment.Name="ExecFlyAttachment"
    local linearVelocity=Mk("LinearVelocity",rootPart)
    linearVelocity.Name="ExecFlyVelocity"
    linearVelocity.Attachment0=attachment
    linearVelocity.RelativeTo=Enum.ActuatorRelativeTo.World
    linearVelocity.MaxForce=math.huge
    linearVelocity.VectorVelocity=Vector3.zero
    linearVelocity.Enabled=true
    local lastPos=rootPart.Position
    local stuckSince=tick()
    while getgenv().AutoArrestActive and rootPart and rootPart.Parent do
        if CheckLagback(rootPart) then break end
        local moved=(rootPart.Position-lastPos).Magnitude
        if moved>=Config.AntiStuckMinMove then
            lastPos=rootPart.Position
            stuckSince=tick()
        elseif tick()-stuckSince>=Config.AntiStuckTimeout then
            ResetCharacter("anti-stuck during flight")
            break
        end
        local dist=(rootPart.Position-targetPos).Magnitude
        if dist<=(stopDist or 10) then break end
        local velocity=(targetPos-rootPart.Position).Unit*(speed or Config.PlayerFlySpeed)
        if useTerrain then
            local groundY,peakY,mountainFound,forwardDist=ScanTerrainAhead(rootPart,velocity)
            local targetHeight=groundY+5
            if mountainFound then targetHeight=peakY+20 end
            local yDiff=targetHeight-rootPart.Position.Y
            local vy=0
            if yDiff>1 then vy=math.clamp(yDiff*6,25,170) elseif yDiff<-1 then vy=-math.clamp(math.abs(yDiff)*4,20,350) end
            local x,z=velocity.X,velocity.Z
            if forwardDist<15 and yDiff>5 then x=x*0.3 z=z*0.3 end
            if Vector3.new(x,0,z).Magnitude<0.1 and yDiff>5 then
                local f=rootPart.CFrame.LookVector
                x=f.X*(speed or Config.PlayerFlySpeed)*0.4
                z=f.Z*(speed or Config.PlayerFlySpeed)*0.4
            end
            velocity=Vector3.new(x,vy,z)
        end
        linearVelocity.VectorVelocity=velocity
        task.wait()
    end
    if linearVelocity and linearVelocity.Parent then linearVelocity:Destroy() end
    if attachment and attachment.Parent then attachment:Destroy() end
end
