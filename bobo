local function GetCurrentVehicle()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local seat = hum and hum.SeatPart

    if seat then
        return seat:FindFirstAncestorOfClass("Model") or seat.Parent
    end

    return nil
end

local function GetTargetVehicle(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local seat = hum and hum.SeatPart

    if seat then
        return seat:FindFirstAncestorOfClass("Model") or seat.Parent
    end

    local vehiclesFolder = workspace:FindFirstChild("Vehicles")

    if vehiclesFolder then
        local root = char and char:FindFirstChild("HumanoidRootPart")

        if root then    
            for _, v in ipairs(vehiclesFolder:GetChildren()) do    
                if (v:GetPivot().Position - root.Position).Magnitude < 15 then    
                    return v    
                end    
            end    
        end
    end

    return nil
end

IsInVehicle = function()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    return (hum and (hum.Sit or hum.SeatPart ~= nil))
    or (GetCurrentVehicle() ~= nil)
end

