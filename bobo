-- ===== MULTI-RAY OVERHEAD ENCLOSURE DETECTOR ===============
-- ============================================================

local enclosureCache = setmetatable({}, {
    __mode = "k"
})

local function GetOverheadExclusionList(character)
    local exclusionList = {}

    if character then
        table.insert(exclusionList, character)
    end

    if LocalPlayer.Character and LocalPlayer.Character ~= character then
        table.insert(exclusionList, LocalPlayer.Character)
    end

    local vehiclesFolder = workspace:FindFirstChild("Vehicles")

    if vehiclesFolder then
        table.insert(exclusionList, vehiclesFolder)
    end

    for _, player in ipairs(Players:GetPlayers()) do
        local playerCharacter = player.Character

        if playerCharacter then    
            table.insert(exclusionList, playerCharacter)    
        end
    end

    return exclusionList
end

local function HasStructuralAncestor(instance)
    if not instance then return false end

    local current = instance

    for _ = 1, 5 do
        if not current then break end

        local lower = current.Name:lower()    

        if lower:find("building", 1, true)    
            or lower:find("roof", 1, true)    
            or lower:find("ceiling", 1, true)    
            or lower:find("cave", 1, true)    
            or lower:find("structure", 1, true)    
            or lower:find("tunnel", 1, true)    
            or lower:find("garage", 1, true)    
            or lower:find("interior", 1, true)    
            or lower:find("warehouse", 1, true)    
            or lower:find("basement", 1, true) then    

            return true    
        end    

        current = current.Parent
    end

    return false
end

local function IsLikelyOverheadGeometry(rayResult)
    if not rayResult or not rayResult.Instance then
        return false
    end

    local hitInstance = rayResult.Instance

    if hitInstance == workspace.Terrain then
        return true
    end

    if not hitInstance:IsA("BasePart") then
        return false
    end

    local partName = hitInstance.Name:lower()

    if partName:find("tree", 1, true)
    or partName:find("leaf", 1, true)
    or partName:find("foliage", 1, true)
    or partName:find("branch", 1, true)
    or partName:find("bush", 1, true) then
        if not HasStructuralAncestor(hitInstance) then    
            return false    
        end
    end

    local normal = rayResult.Normal
    local overheadFace = normal.Y <= -0.15

    if not overheadFace then
        return HasStructuralAncestor(hitInstance)
    end

    local size = hitInstance.Size
    local horizontalArea = size.X * size.Z

    local widePart = (size.X >= 4 and size.Z >= 4) or horizontalArea >= 30
    local structuralPart = HasStructuralAncestor(hitInstance)

    if widePart or structuralPart then
        return true
    end

    if hitInstance.Material == Enum.Material.Concrete
    or hitInstance.Material == Enum.Material.Rock
    or hitInstance.Material == Enum.Material.Cobblestone
    or hitInstance.Material == Enum.Material.Brick
    or hitInstance.Material == Enum.Material.Slate then
        return horizontalArea >= 12
    end

    return false
end

local function IsUndergroundOrIndoor(character)
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not root then return true end

    local now = tick()
    local cached = enclosureCache[character]

    if cached
    and now - cached.time <= Config.OverheadCacheTime
    and (root.Position - cached.position).Magnitude <= Config.OverheadCacheMoveDistance then
        return cached.result
    end

    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = GetOverheadExclusionList(character)
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.IgnoreWater = true

    local origin = root.Position + Vector3.new(0, 1.5, 0)

    local samples = {
        { offset = Vector3.new(0, 0, 0), outer = false, quadrant = 0 },
        { offset = Vector3.new(Config.OverheadInnerRadius, 0, 0), outer = false, quadrant = 1 },    
        { offset = Vector3.new(-Config.OverheadInnerRadius, 0, 0), outer = false, quadrant = 2 },    
        { offset = Vector3.new(0, 0, Config.OverheadInnerRadius), outer = false, quadrant = 3 },    
        { offset = Vector3.new(0, 0, -Config.OverheadInnerRadius), outer = false, quadrant = 4 },    
        { offset = Vector3.new(Config.OverheadOuterRadius, 0, 0), outer = true, quadrant = 1 },    
        { offset = Vector3.new(-Config.OverheadOuterRadius, 0, 0), outer = true, quadrant = 2 },    
        { offset = Vector3.new(0, 0, Config.OverheadOuterRadius), outer = true, quadrant = 3 },    
        { offset = Vector3.new(0, 0, -Config.OverheadOuterRadius), outer = true, quadrant = 4 },    
        { offset = Vector3.new(Config.OverheadOuterRadius * 0.707, 0, Config.OverheadOuterRadius * 0.707), outer = true, quadrant = 3 },    
        { offset = Vector3.new(-Config.OverheadOuterRadius * 0.707, 0, Config.OverheadOuterRadius * 0.707), outer = true, quadrant = 4 },    
        { offset = Vector3.new(Config.OverheadOuterRadius * 0.707, 0, -Config.OverheadOuterRadius * 0.707), outer = true, quadrant = 1 },    
        { offset = Vector3.new(-Config.OverheadOuterRadius * 0.707, 0, -Config.OverheadOuterRadius * 0.707), outer = true, quadrant = 2 }
    }

    local centerHit = false
    local totalHits = 0
    local outerHits = 0

    local hitHeights = {}
    local quadrantHits = {}
    local hitInstances = {}

    for index, sample in ipairs(samples) do
        local sampleOrigin = origin + sample.offset
        local result = workspace:Raycast(sampleOrigin, Vector3.new(0, Config.OverheadRayDistance, 0), raycastParams)    

        if IsLikelyOverheadGeometry(result) then    
            totalHits = totalHits + 1    
            local hitY = result.Position.Y    
            table.insert(hitHeights, hitY)    
            hitInstances[result.Instance] = true    

            if index == 1 then centerHit = true end    
            if sample.outer then    
                outerHits = outerHits + 1    
                quadrantHits[sample.quadrant] = true    
            end    
        end
    end

    local result = false
    local medianHeight = nil
    local clusteredHits = 0
    local quadrantCount = 0

    if #hitHeights > 0 then
        table.sort(hitHeights)
        local middleIndex = math.ceil(#hitHeights / 2)    
        medianHeight = hitHeights[middleIndex]    

        for _, y in ipairs(hitHeights) do    
            if math.abs(y - medianHeight) <= Config.OverheadClusterTolerance then    
                clusteredHits = clusteredHits + 1    
            end    
        end    

        for _ in pairs(quadrantHits) do    
            quadrantCount = quadrantCount + 1    
        end    

        if centerHit and clusteredHits >= Config.OverheadMinHits then    
            local strongOuterCoverage = outerHits >= Config.OverheadOuterMinHits and quadrantCount >= Config.OverheadQuadrantMin    
            local strongOverallCoverage = totalHits >= Config.OverheadMinHits + 2    

            if strongOuterCoverage or strongOverallCoverage then    
                result = true    
            end    
        end
    end

    enclosureCache[character] = {
        time = now,
        position = root.Position,
        result = result
    }

    if result and Config.OverheadDebug then
        print("[ENCLOSURE] " .. character.Name .. " | hits=" .. tostring(totalHits) .. " | center=" .. tostring(centerHit))
    end

    return result
end

