    if not uiModule or not uiModule.CircleAction or not uiModule.CircleAction.Specs then
        return false
    end
    local driverSeat=GetVehicleSeat(carModel)
    local chosen=nil
    for _,spec in pairs(uiModule.CircleAction.Specs) do
        local part=spec.Part
        if part and part:IsDescendantOf(carModel) then
            if driverSeat and part==driverSeat then
                chosen=spec
                break
            end
            local text=tostring(spec.Text or ""):lower()
            local partName=part.Name:lower()
            if (text:find("driver") or text:find("drive")) and not text:find("passenger") and not text:find("eject") then
                chosen=spec
                break
            end
            if not chosen and not text:find("passenger") and not text:find("eject") and not partName:find("passenger") then
                chosen=spec
            end
        end
    end
    if not chosen or type(chosen.Callback)~="function" then
        return false
    end
    task.spawn(function()
        pcall(function()
            chosen:Callback(true)
        end)
    end)
    return true
